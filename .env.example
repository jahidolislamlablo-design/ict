# Server Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas URI for live hosting)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ict_easy_learning

# Strong random secret for signing JWT tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_64_char_random_hex_secret

# Comma-separated list of allowed frontend origins in production
ALLOWED_ORIGINS=https://jahidolislamlablo-design.github.io
